# Copier en .env.development et renseigner. Ne jamais versionner de valeurs réelles.

SERVER_PORT=3300
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/investment_plateform"
ORIGINS="http://localhost:5173"
SALT_ROUNDS=10
COOKIE_JWT_NAME="AUTH_TOKEN"

# JWT (RS256) — générer avec scripts/rotate-jwt-keys.cjs
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_PRIVATE_KEY_PASSPHRASE=
# JWT_EXPIRES_IN=24h

EXCHANGE_RATE_URL=https://v6.exchangerate-api.com/v6/
EXCHANGE_RATE_API_KEY=

# Alpaca Trading API — compte PARTAGÉ (clés du compte, tableau de bord Alpaca)
# Renseignées, elles priment sur OAuth : tous les utilisateurs tradent sur ce
# compte. ALPACA_KEY_ENVIRONMENT = LIVE (clés AK…) ou PAPER (clés PK…), et doit
# figurer dans BROKER_ALLOWED_ENVIRONMENTS. Voir docs/ALPACA_OAUTH.md.
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_KEY_ENVIRONMENT=
# Bascule paper ↔ live sans toucher à l'application : ALPACA_TRADING_MODE choisit
# les clés (ALPACA_PAPER_* ou ALPACA_LIVE_*, à défaut ALPACA_KEY) et le serveur
# impose cet environnement, quel que soit celui que l'application demande.
# Vide : ALPACA_KEY_ENVIRONMENT décide. Redémarrer le serveur après changement.
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=
ALPACA_TRADING_MODE=

# Alpaca Trading API — OAuth (un compte Alpaca par utilisateur), si ALPACA_KEY est vide
# Vides : seules les routes d'autorisation répondent BROKER_NOT_CONFIGURED.
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
# Adresse publique du backend, identique à celle déclarée sur Alpaca Connect
ALPACA_OAUTH_REDIRECT_URI=https://<hote>/api/v1/broker/alpaca/callback
ALPACA_OAUTH_SCOPES=trading
BROKER_DEFAULT_ENVIRONMENT=PAPER
BROKER_ALLOWED_ENVIRONMENTS=PAPER,LIVE
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BROKER_TOKEN_KEY_ID=k00000000
BROKER_TOKEN_KEY=
# BROKER_TOKEN_PREVIOUS_KEYS=id:base64
MOBILE_RETURN_URL_ALLOWLIST=amara:,exp://<IP du poste>:8081,http://localhost:8081

# Ordres
ORDER_FEE_RATE=0
ORDER_MIN_NOTIONAL_USD=1
ORDER_MAX_NOTIONAL_USD=
FX_REFRESH_SECONDS=600
FX_MAX_AGE_SECONDS=3600
ORDER_SYNC_ENABLED=true
ORDER_SYNC_INTERVAL_SECONDS=15

# Notifications push (service Expo Push). Facultatif : requis seulement si la
# « sécurité renforcée des envois » est activée sur le projet Expo.
EXPO_ACCESS_TOKEN=
